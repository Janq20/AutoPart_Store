<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoPart Store</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyApp.styles.css" asp-append-version="true" />
</head>
<body class="@(User.IsInRole(MyApp.Models.UserRoles.Administrator) ? "role-admin" : User.IsInRole(MyApp.Models.UserRoles.Employee) ? "role-employee" : User.IsInRole(MyApp.Models.UserRoles.Client) ? "role-client" : "")">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark-icon">A</span><span>Auto<span>Part</span> Store</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav mx-auto gap-lg-3">
                            <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Katalog części</a></li>
                            @if (User.IsInRole(MyApp.Models.UserRoles.Administrator) ||
                                 User.IsInRole(MyApp.Models.UserRoles.Employee))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Orders">Zamówienia</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="InventoryTransactions">Ruchy magazynowe</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Products">Asortyment</a></li>
                            }
                            @if (User.IsInRole(MyApp.Models.UserRoles.Administrator))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Użytkownicy</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link nav-cart" asp-controller="Cart" asp-action="Index"><span aria-hidden="true">🛒</span> Koszyk</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Wyloguj</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav mx-auto gap-lg-3">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Start</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Katalog części</a></li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center gap-lg-2">
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Zaloguj</a></li>
                            <li class="nav-item"><a class="btn btn-nav" asp-controller="Account" asp-action="Register">Załóż konto</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between gap-3">
                <span>&copy; 2026 AutoPart Store</span>
                <span>Najlepsze części dla Twojego auta</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>