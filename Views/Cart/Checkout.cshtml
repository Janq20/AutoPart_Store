@model MyApp.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Finalizacja zamówienia";
    var addresses = ViewBag.Addresses as IReadOnlyList<MyApp.Models.Address> ?? [];
}

<div class="container py-4">
    <h1 class="h2 mb-4">Finalizacja zamówienia</h1>
    <form asp-action="Checkout" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-4">
            <div class="col-md-6">
                <h2 class="h5">Dostawa</h2>
                @if (addresses.Count > 0)
                {
                    <label asp-for="AddressId" class="form-label">Zapisany adres</label>
                    <select asp-for="AddressId" class="form-select mb-3">
                        <option value="">Nowy adres</option>
                        @foreach (var address in addresses)
                        {
                            <option value="@address.Id">@address.Street, @address.PostalCode @address.City</option>
                        }
                    </select>
                }
                <input asp-for="Street" class="form-control mb-2" placeholder="Ulica i numer" />
                <input asp-for="City" class="form-control mb-2" placeholder="Miasto" />
                <input asp-for="PostalCode" class="form-control mb-2" placeholder="Kod pocztowy" />
                <input asp-for="PhoneNumber" class="form-control" placeholder="Telefon" />
            </div>
            <div class="col-md-6">
                <h2 class="h5">Płatność online</h2>
                <p class="text-muted small">To jest bezpieczny symulator płatności. Dane karty nie są zapisywane.</p>
                <input asp-for="CardNumber" class="form-control mb-2" placeholder="Numer karty (16 cyfr)" />
                <input asp-for="Expiry" class="form-control mb-2" placeholder="Ważna do (MM/YY)" />
                <input asp-for="Cvv" class="form-control" placeholder="CVV" />
            </div>
        </div>
        <button type="submit" class="btn btn-success mt-4">Zapłać i złóż zamówienie</button>
        <a asp-action="Index" class="btn btn-outline-secondary mt-4">Wróć do koszyka</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
