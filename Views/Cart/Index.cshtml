@model MyApp.Models.CartViewModel
@{
    ViewData["Title"] = "Koszyk";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="h2 mb-0">Koszyk</h1>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">Wróć do katalogu</a>
    </div>

    @if (TempData["CartError"] is string cartError)
    {
        <div class="alert alert-warning" role="alert">@cartError</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">Koszyk jest pusty.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Cena</th>
                        <th>Ilość</th>
                        <th>Wartość</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.UnitPrice.ToString("F2") zł</td>
                            <td>
                                <form asp-action="Update" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input name="quantity" type="number" min="0" max="@item.AvailableStock" value="@item.Quantity" class="form-control" style="max-width: 100px" aria-label="Ilość produktu @item.Name" />
                                    <button type="submit" class="btn btn-outline-primary">Aktualizuj</button>
                                </form>
                                <small class="text-muted">Dostępne: @item.AvailableStock. Wpisz 0, aby usunąć.</small>
                            </td>
                            <td>@item.LineTotal.ToString("F2") zł</td>
                            <td>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-outline-danger">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Razem:</th>
                        <th>@Model.Total.ToString("F2") zł</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-danger">Opróżnij koszyk</button>
        </form>
    }
</div>
