@model MyApp.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Dodaj kategorię";
}

<div class="container py-4">
    <h1 class="h2 mb-4">Dodaj kategorię</h1>
    <form asp-action="CreateCategory" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ParentCategoryId" class="form-label"></label>
            <select asp-for="ParentCategoryId" asp-items="Model.ParentCategories" class="form-select">
                <option value="">Brak — kategoria główna</option>
            </select>
            <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Zapisz kategorię</button>
            <a asp-action="Categories" class="btn btn-outline-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
