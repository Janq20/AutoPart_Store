@model MyApp.Models.ManageOrdersViewModel
@{
    ViewData["Title"] = "Zarządzanie zamówieniami";
}

<div class="container py-4">
    <h1 class="h2 mb-4">Zarządzanie zamówieniami</h1>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">Brak złożonych zamówień.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Numer</th>
                        <th>Data</th>
                        <th>Klient</th>
                        <th>Pozycje</th>
                        <th>Kwota</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                            <td>@order.CustomerName<br /><small class="text-muted">@order.CustomerEmail</small></td>
                            <td>@order.ItemCount</td>
                            <td>@order.TotalAmount.ToString("F2") zł</td>
                            <td>@order.Status</td>
                            <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
