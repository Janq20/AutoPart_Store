@model IReadOnlyList<MyApp.Models.OrderListItemViewModel>
@{
    ViewData["Title"] = "Zamówienia";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 admin-page-heading">
        <div>
            <span class="eyebrow">OBSŁUGA KLIENTA</span>
            <h1 class="h2 mb-0 mt-2">Aktualne zamówienia</h1>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Panel główny</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="dashboard-icon">✓</span>
            <h2>Brak nowych zamówień</h2>
            <p>Gdy klient potwierdzi zakup, jego zamówienie pojawi się tutaj.</p>
        </div>
    }
    else
    {
        <div class="order-summary-grid mb-4">
            <div class="order-summary-card"><span>Wszystkie zamówienia</span><strong>@Model.Count</strong></div>
            <div class="order-summary-card"><span>Nowe zamówienia</span><strong>@Model.Count(order => order.Status == "Nowe")</strong></div>
            <div class="order-summary-card"><span>Łączna wartość</span><strong>@Model.Sum(order => order.TotalAmount).ToString("F2") zł</strong></div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle order-table">
                <thead>
                    <tr>
                        <th>Numer</th>
                        <th>Klient</th>
                        <th>Data</th>
                        <th>Pozycje</th>
                        <th>Status</th>
                        <th>Wartość</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td><strong>@order.CustomerName</strong><small>@order.CustomerEmail</small></td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.ItemCount</td>
                            <td><span class="order-status">@order.Status</span></td>
                            <td><strong>@order.TotalAmount.ToString("F2") zł</strong></td>
                            <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Szczegóły</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
