@model MyApp.Models.OrderDetailsViewModel
@{
    ViewData["Title"] = $"Zamówienie #{Model.Id}";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 admin-page-heading">
        <div>
            <span class="eyebrow">SZCZEGÓŁY ZAMÓWIENIA</span>
            <h1 class="h2 mb-0 mt-2">Zamówienie #@Model.Id</h1>
        </div>
        <a asp-action="Orders" class="btn btn-outline-secondary">Wróć do zamówień</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <section class="order-info-card">
                <span class="order-info-label">KLIENT</span>
                <h2>@Model.CustomerName</h2>
                <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                <hr />
                <span class="order-info-label">ZAMÓWIENIE</span>
                <p class="mb-2">Data: <strong>@Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></p>
                <p class="mb-0">Status: <span class="order-status">@Model.Status</span></p>
            </section>
        </div>
        <div class="col-lg-8">
            <section class="order-items-card">
                <h2>Co kupił klient?</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>Produkt</th><th>Ilość</th><th>Cena</th><th>Razem</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("F2") zł</td>
                                    <td><strong>@item.TotalPrice.ToString("F2") zł</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Razem:</th><th>@Model.TotalAmount.ToString("F2") zł</th></tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
