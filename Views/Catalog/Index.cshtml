@model MyApp.Models.CatalogViewModel
@{
    ViewData["Title"] = "Katalog części";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Katalog części</h1>
            <p class="text-muted mb-0">Wyszukaj części i sprawdź ich dostępność.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">Koszyk</a>
        }
    </div>

    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div class="alert alert-success" role="status">@cartMessage</div>
    }
    @if (TempData["CartError"] is string cartError)
    {
        <div class="alert alert-warning" role="alert">@cartError</div>
    }

    <form asp-action="Index" method="get" class="card card-body mb-4">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <label for="search" class="form-label">Szukaj produktu</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Nazwa lub opis" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="parentCategoryId" class="form-label">Kategoria</label>
                <select id="parentCategoryId" name="parentCategoryId" class="form-select">
                    <option value="">Wszystkie kategorie</option>
                    @foreach (var category in Model.ParentCategories)
                    {
                        if (category.Value == Model.ParentCategoryId?.ToString())
                        {
                            <option value="@category.Value" selected>@category.Text</option>
                        }
                        else
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="categoryId" class="form-label">Podkategoria</label>
                <select id="categoryId" name="categoryId" class="form-select" disabled="@(Model.Categories.Count == 0)">
                    <option value="">Wszystkie podkategorie</option>
                    @foreach (var category in Model.Categories)
                    {
                        if (category.Value == Model.SubcategoryId?.ToString())
                        {
                            <option value="@category.Value" selected>@category.Text</option>
                        }
                        else
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label for="minimumPrice" class="form-label">Cena od (zł)</label>
                <input id="minimumPrice" name="minimumPrice" type="number" step="0.01" min="0" value="@Model.MinimumPrice" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label for="maximumPrice" class="form-label">Cena do (zł)</label>
                <input id="maximumPrice" name="maximumPrice" type="number" step="0.01" min="0" value="@Model.MaximumPrice" class="form-control" />
            </div>
            <div class="col-12 col-md-4 col-lg-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input id="inStockOnly" name="inStockOnly" value="true" type="checkbox" class="form-check-input" checked="@Model.InStockOnly" />
                    <label for="inStockOnly" class="form-check-label">Tylko dostępne</label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtruj</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść filtry</a>
            </div>
        </div>
    </form>

    <p class="text-muted">Znaleziono produktów: @Model.Products.Count</p>
    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-info">Brak produktów spełniających wybrane kryteria.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <span class="badge text-bg-light">@product.Category?.Name</span>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge text-bg-success">Dostępny: @product.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Brak w magazynie</span>
                                }
                            </div>
                            <h2 class="h5 card-title">@product.Name</h2>
                            <p class="card-text text-muted flex-grow-1">@product.Description</p>
                            <p class="h4 mb-3">@product.Price.ToString("F2") zł</p>
                            @if (User.Identity?.IsAuthenticated == true && product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <label class="visually-hidden" for="quantity-@product.Id">Ilość</label>
                                    <input id="quantity-@product.Id" name="quantity" type="number" min="1" max="@product.StockQuantity" value="1" class="form-control" style="max-width: 90px" />
                                    <button type="submit" class="btn btn-primary flex-grow-1">Dodaj do koszyka</button>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Zaloguj się, aby kupić</a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        const parentCategory = document.getElementById("parentCategoryId");
        const category = document.getElementById("categoryId");
        const selectedCategoryId = "@Model.SubcategoryId";

        async function loadSubcategories(selectedId = "") {
            category.replaceChildren(new Option("Wszystkie podkategorie", ""));
            category.disabled = true;
            if (!parentCategory.value) return;

            const response = await fetch(`/Catalog/Subcategories?parentCategoryId=${encodeURIComponent(parentCategory.value)}`);
            if (!response.ok) return;
            const categories = await response.json();
            for (const item of categories) {
                category.add(new Option(item.name, item.id));
            }
            category.disabled = categories.length === 0;
            category.value = selectedId;
        }

        parentCategory.addEventListener("change", () => loadSubcategories());
        if (parentCategory.value) loadSubcategories(selectedCategoryId);
    </script>
}
