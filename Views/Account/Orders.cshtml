@model IReadOnlyList<MyApp.Models.OrderListItemViewModel>
@{
    ViewData["Title"] = "Moje zamówienia";
}
<div class="container py-4">
    <h1 class="h2 mb-4">Moje zamówienia</h1>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Nie masz jeszcze zamówień.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Numer</th><th>Data</th><th>Status</th><th>Płatność</th><th>Wartość</th><th></th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.Status</td>
                        <td>@order.PaymentStatus</td>
                        <td>@order.TotalAmount.ToString("F2") zł</td>
                        <td><a asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Pobierz fakturę PDF</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
